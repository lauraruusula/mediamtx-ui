{
  "name": "admin-mediamtx",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd ../mediamtx && go build -o mediamtx . && ./mediamtx ../mediamtx-ui/mediamtx-dev.yml",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,js,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,css}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.7",
    "echarts": "^6.0.0",
    "element-plus": "^2.5.6",
    "pinia": "^2.1.7",
    "vue": "^3.4.19",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.9.0",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true
  }
}
